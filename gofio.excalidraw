      "text": "if a json file exists and it's structure is\nunknown, how do you Marshal/Unmarshal it",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if a json file exists and it's structure is unknown, how do you Marshal/Unmarshal it",
      "autoResize": false,
      "lineHeight": 1.25
